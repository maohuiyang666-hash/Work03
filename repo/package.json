{
  "name": "workspace",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "npm exec --package=eslint@9.39.1 --package=@eslint/js@9.39.1 --package=typescript-eslint@8.46.4 --package=globals@16.4.0 --package=eslint-plugin-react-hooks@7.0.1 --package=eslint-plugin-react-refresh@0.4.24 -- eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" vite.config.ts playwright.config.ts vitest.setup.ts --max-warnings 0",
    "test": "npm exec --package=vitest@3.2.4 --package=jsdom@27.1.0 --package=@testing-library/react@16.3.0 --package=@testing-library/user-event@14.6.1 --package=@testing-library/jest-dom@6.9.1 -- vitest run",
    "test:coverage": "npm exec --package=vitest@3.2.4 --package=@vitest/coverage-v8@3.2.4 --package=jsdom@27.1.0 --package=@testing-library/react@16.3.0 --package=@testing-library/user-event@14.6.1 --package=@testing-library/jest-dom@6.9.1 -- vitest run --coverage",
    "e2e": "npm exec --package=@playwright/test@1.58.2 -- playwright test",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aidp/web-code-check": "^1.1.10",
    "playwright": "^1.58.2",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  }
}
